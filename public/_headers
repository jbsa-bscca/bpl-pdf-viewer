# Cloudflare Pages CDN & Cache Headers

# Cache PDF for 1 year (immutable) & allow byte ranges for instant streaming
/BPL_Registered_Players.pdf
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Accept-Ranges: bytes

# Cache PDF.js worker and scripts
/pdf.worker.min.mjs
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/pdf.min.mjs
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Cache static hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
